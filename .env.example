# Copy to .env (never commit .env). All are optional for `make data` / `make train`.
# Optional: lets the Insight Agent write plain-language summaries (numbers still come from SQL)
ANTHROPIC_API_KEY=
# HI_LLM_MODEL=claude-opus-5-5
# Optional: switch a source off (e.g. if the organisers do not approve it). Gate 0 rejects it,
# nothing is fetched or read, and the model trains without its features.
# HI_EXCLUDE_SOURCES=open_meteo
# Needed only for publishing to Hugging Face (hourly flow + Space deploy)
HF_TOKEN=
HI_HF_DATASET=your-team/hackinsight-live
